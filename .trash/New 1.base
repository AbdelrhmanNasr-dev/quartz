formulas:
  deadline: (publishDate + "7 days") < today()
views:
  - type: table
    name: New
    filters:
      and:
        - file.hasTag("#new")
    groupBy:
      property: formula.deadline
      direction: ASC
    order:
      - file.name
      - formula.deadline
      - publishDate
      - tags
      - date
    sort: []
    columnSize:
      file.name: 112
      formula.deadline: 93
      note.tags: 131
      note.publishDate: 139
