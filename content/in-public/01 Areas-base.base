  - type: table
    name: Career growth
    filters:
      and:
        - '!file.inFolder("99 - Metadata/Templetes")'
        - category.containsAny("skill", "hobby")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - title
      - category
      - type
      - formula.bar
      - target
      - tags
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 171
      note.title: 141
      note.category: 190
      formula.bar: 153
