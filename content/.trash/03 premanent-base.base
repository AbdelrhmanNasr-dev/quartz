summaries:
  new summary: date(date).format("YYYY")
filters:
  and:
    - file.inFolder("03 - Permanent")
formulas:
  Year: date(date).format("YYYY-MM-DD")
properties:
  note.quate:
    displayName: quote
views:
  - type: table
    name: Concepts
    filters:
      and:
        - file.inFolder("in-public/03 Permanent")
    order:
      - file.name
      - type
      - source
      - date
    sort:
      - property: source
        direction: ASC
      - property: tags
        direction: ASC
    columnSize:
      file.name: 379
      note.date: 142
